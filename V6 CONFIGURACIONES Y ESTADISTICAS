for(const n of [1,2]){
 document.getElementById("color"+n).addEventListener("input",e=>actualizarColor(n,e.target.value));
 document.getElementById("hex"+n).addEventListener("change",e=>{
  let v=e.target.value.trim();if(!v.startsWith("#"))v="#"+v;actualizarColor(n,v);
 });
}
for(const tipo of ["caida","victoria","empate","botones"]){
 const id="sonido"+tipo[0].toUpperCase()+tipo.slice(1);
