 if(partidaRegistrada)return;
 partidaRegistrada=true;
 if(modoActual==="cpu"){
  if(resultado===1){
   estadisticas.cpu.ganadas++;estadisticas.cpu.racha++;
   estadisticas.cpu.mejorRacha=Math.max(estadisticas.cpu.mejorRacha,estadisticas.cpu.racha);
  }else if(resultado===2){estadisticas.cpu.perdidas++;estadisticas.cpu.racha=0}
  else{estadisticas.cpu.empates++;estadisticas.cpu.racha=0}
 }else{
  if(resultado===1)estadisticas.local.p1++;
  else if(resultado===2)estadisticas.local.p2++;
  else estadisticas.local.empates++;
 }
 guardarEstadisticas();
}
function actualizarEstadisticas(){
 const c=estadisticas.cpu,l=estadisticas.local;
 poner("cpuGanadas",c.ganadas);poner("cpuPerdidas",c.perdidas);poner("cpuEmpates",c.empates);
 poner("cpuTotal",c.ganadas+c.perdidas+c.empates);poner("rachaActual",c.racha);poner("rachaMaxima",c.mejorRacha);
 poner("localP1",l.p1);poner("localP2",l.p2);poner("localEmpates",l.empates);
 poner("localTotal",l.p1+l.p2+l.empates);
}
