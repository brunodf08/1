}
function volverMenu(){
 clearTimeout(temporizadorCPU);cpuPensando=false;juegoTerminado=true;
 pantallaJuego.classList.remove("entrada");pantallaJuego.classList.add("salida");
 temporizadorSalida=setTimeout(()=>{
  pantallaJuego.style.display="none";pantallaJuego.classList.remove("salida");
  document.getElementById("menu").style.display="block";
 },240);
}
function iniciarJuego(){
 clearTimeout(temporizadorCPU);tablero=Array.from({length:FILAS},()=>Array(COLUMNAS).fill(0));
 jugadorActual=1;juegoTerminado=false;ultimaFicha=null;columnaSeleccionada=null;cpuPensando=false;partidaRegistrada=false;
 elementoEstado.classList.remove("resultado","cambio-turno");
 zonaJuego.classList.remove("entrada-tablero");void zonaJuego.offsetWidth;zonaJuego.classList.add("entrada-tablero");
 dibujarSelector();dibujarTablero();actualizarEstado();
}
function dibujarSelector(){
 elementoSelector.innerHTML="";
 for(let c=0;c<COLUMNAS;c++){
  const espacio=document.createElement("div");espacio.className="selector-columna";espacio.dataset.col=c;
  const ficha=document.createElement("div");ficha.className="ficha-preview";espacio.appendChild(ficha);elementoSelector.appendChild(espacio);
 }
}
function mostrarFichaSuperior(columna){
 if(juegoTerminado||cpuPensando||(modoActual==="cpu"&&jugadorActual===2)){ocultarFichaSuperior();return}
 columnaSeleccionada=columna;
 elementoSelector.querySelectorAll(".selector-columna").forEach((el,i)=>{
  const ficha=el.querySelector(".ficha-preview");el.classList.remove("activa");ficha.classList.remove("visible");
  ficha.style.background="transparent";
  if(i===columna){el.classList.add("activa");ficha.classList.add("visible");ficha.style.background=colorJugador(jugadorActual)}
 });
}
function ocultarFichaSuperior(){
 columnaSeleccionada=null;
 elementoSelector.querySelectorAll(".selector-columna").forEach(el=>{
  el.classList.remove("activa");el.querySelector(".ficha-preview").classList.remove("visible");
 });
}
function dibujarTablero(){
 elementoTablero.innerHTML="";
 for(let f=0;f<FILAS;f++)for(let c=0;c<COLUMNAS;c++){
  const celda=document.createElement("div");celda.className="celda";celda.dataset.col=c;
  const valor=tablero[f][c];
  if(valor!==0){
   const ficha=document.createElement("div");ficha.className="ficha";ficha.style.background=colorJugador(valor);
   if(ultimaFicha&&ultimaFicha.fila===f&&ultimaFicha.columna===c){
    ficha.classList.add("caida");
    ficha.addEventListener("animationend",()=>{
     celda.classList.add("impacto");elementoTablero.classList.remove("golpe");void elementoTablero.offsetWidth;elementoTablero.classList.add("golpe");
    },{once:true});
   }
   celda.appendChild(ficha);
  }
  elementoTablero.appendChild(celda);
 }
}
zonaJuego.addEventListener("pointermove",e=>{
 const el=e.target.closest("[data-col]");if(el)mostrarFichaSuperior(Number(el.dataset.col));
});
zonaJuego.addEventListener("pointerleave",ocultarFichaSuperior);
zonaJuego.addEventListener("click",e=>{
 const el=e.target.closest("[data-col]");if(el)colocarFicha(Number(el.dataset.col));
});
function colocarFicha(columna,esCPU=false){
 if(juegoTerminado||columna<0||columna>=COLUMNAS)return;
 if(cpuPensando&&!esCPU)return;
 if(modoActual==="cpu"&&jugadorActual===2&&!esCPU)return;
 if(esCPU)cpuPensando=false;
 for(let fila=FILAS-1;fila>=0;fila--){
  if(tablero[fila][columna]===0){
   tablero[fila][columna]=jugadorActual;ultimaFicha={fila,columna};sonido("caida");dibujarTablero();
   if(comprobarVictoria(fila,columna)){
    juegoTerminado=true;ocultarFichaSuperior();registrarPartida(jugadorActual);
    mostrarResultado(modoActual==="cpu"&&jugadorActual===2?"¡La computadora ganó!":"¡Ganó el jugador "+jugadorActual+"!");
    sonido("victoria");return;
   }
   if(tableroLleno()){
    juegoTerminado=true;ocultarFichaSuperior();registrarPartida(0);mostrarResultado("¡Empate!");sonido("empate");return;
   }
   if(modoActual==="cpu"&&jugadorActual===1){
    jugadorActual=2;cpuPensando=true;ocultarFichaSuperior();actualizarEstado();
    temporizadorCPU=setTimeout(jugarCPU,550);return;
   }
   jugadorActual=jugadorActual===1?2:1;actualizarEstado();
   if(modoActual==="local")mostrarFichaSuperior(columna);
   return;
  }
 }
}
function mostrarResultado(mensaje){
 textoEstado.textContent=mensaje;elementoEstado.classList.remove("cambio-turno");void elementoEstado.offsetWidth;elementoEstado.classList.add("resultado");
 indicador.style.background=jugadorActual===0?"#85878b":colorJugador(jugadorActual);indicador.style.color=indicador.style.background;
}
function actualizarEstado(){
 elementoEstado.classList.remove("resultado","cambio-turno");void elementoEstado.offsetWidth;elementoEstado.classList.add("cambio-turno");
 if(modoActual==="cpu"&&cpuPensando){
  textoEstado.innerHTML='La computadora está pensando<span class="puntos-pensando"><span>.</span><span>.</span><span>.</span></span>';
  indicador.style.background=colorJugador(2);indicador.style.color=colorJugador(2);return;
 }
 textoEstado.textContent=modoActual==="cpu"&&jugadorActual===2?"Turno de la computadora":"Turno del jugador "+jugadorActual;
 indicador.style.background=colorJugador(jugadorActual);indicador.style.color=colorJugador(jugadorActual);
}
function comprobarVictoria(fila,columna){
 const jugador=tablero[fila][columna],direcciones=[[0,1],[1,0],[1,1],[1,-1]];
 for(const [df,dc] of direcciones){
  let posiciones=[{fila,columna}];
  for(const sentido of [1,-1]){
   let f=fila+df*sentido,c=columna+dc*sentido;
   while(f>=0&&f<FILAS&&c>=0&&c<COLUMNAS&&tablero[f][c]===jugador){
    posiciones.push({fila:f,columna:c});f+=df*sentido;c+=dc*sentido;
   }
  }
  if(posiciones.length>=4){marcarGanadoras(posiciones);return true}
 }
 return false;
}
function marcarGanadoras(posiciones){
 const celdas=elementoTablero.querySelectorAll(".celda");
 celdas.forEach(c=>{const f=c.querySelector(".ficha");if(f)f.classList.add("no-ganadora")});
 posiciones.forEach(p=>{
  const f=celdas[p.fila*COLUMNAS+p.columna].querySelector(".ficha");
  if(f){f.classList.remove("no-ganadora");f.classList.add("ganadora")}
 });
}
function tableroLleno(){return tablero.every(f=>f.every(v=>v!==0))}

/* CPU: MINIMAX CON PODA ALFA-BETA */
function copiarTablero(t){return t.map(f=>[...f])}
function columnasDisponibles(t){return Array.from({length:COLUMNAS},(_,i)=>i).filter(c=>t[0][c]===0)}
function obtenerFilaLibre(t,c){for(let f=FILAS-1;f>=0;f--)if(t[f][c]===0)return f;return -1}
function detectarGanador(t){
 for(let f=0;f<FILAS;f++)for(let c=0;c<COLUMNAS;c++){
  const j=t[f][c];if(!j)continue;
  for(const [df,dc] of [[0,1],[1,0],[1,1],[1,-1]]){
   let n=1;for(let i=1;i<4;i++){
    const nf=f+df*i,nc=c+dc*i;
    if(nf<0||nf>=FILAS||nc<0||nc>=COLUMNAS||t[nf][nc]!==j)break;n++;
   }
   if(n===4)return j;
  }
 }
 return 0;
}
function evaluarLinea(linea){
 let cpu=0,humano=0,vacias=0;
 for(const v of linea){if(v===2)cpu++;else if(v===1)humano++;else vacias++}
 let p=0;
 if(cpu===4)p+=10000;else if(cpu===3&&vacias===1)p+=120;else if(cpu===2&&vacias===2)p+=15;
 if(humano===3&&vacias===1)p-=150;else if(humano===2&&vacias===2)p-=12;
 return p;
}
function evaluarTablero(t){
 let p=0;for(let f=0;f<FILAS;f++){if(t[f][3]===2)p+=6;if(t[f][3]===1)p-=6}
 for(let f=0;f<FILAS;f++)for(let c=0;c<COLUMNAS-3;c++)p+=evaluarLinea([t[f][c],t[f][c+1],t[f][c+2],t[f][c+3]]);
 for(let f=0;f<FILAS-3;f++)for(let c=0;c<COLUMNAS;c++)p+=evaluarLinea([t[f][c],t[f+1][c],t[f+2][c],t[f+3][c]]);
 for(let f=0;f<FILAS-3;f++)for(let c=0;c<COLUMNAS-3;c++)p+=evaluarLinea([t[f][c],t[f+1][c+1],t[f+2][c+2],t[f+3][c+3]]);
 for(let f=3;f<FILAS;f++)for(let c=0;c<COLUMNAS-3;c++)p+=evaluarLinea([t[f][c],t[f-1][c+1],t[f-2][c+2],t[f-3][c+3]]);
 return p;
}
function minimax(t,profundidad,alfa,beta,maximizando){
 const ganador=detectarGanador(t),disponibles=columnasDisponibles(t);
 if(ganador===2)return 100000+profundidad;if(ganador===1)return -100000-profundidad;
 if(profundidad===0||!disponibles.length)return evaluarTablero(t);
 const orden=[3,2,4,1,5,0,6];
 if(maximizando){
  let mejor=-Infinity;
  for(const c of orden){if(!disponibles.includes(c))continue;const f=obtenerFilaLibre(t,c),copia=copiarTablero(t);copia[f][c]=2;
   mejor=Math.max(mejor,minimax(copia,profundidad-1,alfa,beta,false));alfa=Math.max(alfa,mejor);if(beta<=alfa)break}
  return mejor;
 }else{
  let mejor=Infinity;
  for(const c of orden){if(!disponibles.includes(c))continue;const f=obtenerFilaLibre(t,c),copia=copiarTablero(t);copia[f][c]=1;
   mejor=Math.min(mejor,minimax(copia,profundidad-1,alfa,beta,true));beta=Math.min(beta,mejor);if(beta<=alfa)break}
  return mejor;
 }
}
function mejorJugadaCPU(){
 const disponibles=columnasDisponibles(tablero),orden=[3,2,4,1,5,0,6];
 let mejorColumna=disponibles[0],mejorValor=-Infinity;
 for(const c of orden){if(!disponibles.includes(c))continue;
  const f=obtenerFilaLibre(tablero,c),copia=copiarTablero(tablero);copia[f][c]=2;
  const valor=minimax(copia,6,-Infinity,Infinity,false);
  if(valor>mejorValor){mejorValor=valor;mejorColumna=c}
 }
 return mejorColumna;
}
function jugarCPU(){if(juegoTerminado||modoActual!=="cpu")return;const c=mejorJugadaCPU();if(c!==undefined)colocarFicha(c,true)}
function reiniciarJuego(){iniciarJuego()}

