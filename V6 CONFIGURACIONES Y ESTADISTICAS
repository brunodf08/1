<script>
/* PREFERENCIAS Y DATOS GUARDADOS */
const DEFAULTS={
 color1:"#e34848",color2:"#327bd1",theme:"light",
 sounds:{caida:true,victoria:true,empate:true,botones:true}
};
function leerGuardado(clave,defecto){
 try{const dato=localStorage.getItem(clave);return dato?JSON.parse(dato):defecto}
 catch(e){return defecto}
}
let preferencias=leerGuardado("cuatroRayaPreferencias",DEFAULTS);
preferencias={...DEFAULTS,...preferencias,sounds:{...DEFAULTS.sounds,...(preferencias.sounds||{})}};
let estadisticas=leerGuardado("cuatroRayaEstadisticas",{
 cpu:{ganadas:0,perdidas:0,empates:0,racha:0,mejorRacha:0},
 local:{p1:0,p2:0,empates:0}
});
function guardarPreferencias(){localStorage.setItem("cuatroRayaPreferencias",JSON.stringify(preferencias))}
function guardarEstadisticas(){localStorage.setItem("cuatroRayaEstadisticas",JSON.stringify(estadisticas))}
function aplicarPreferencias(){
 document.body.dataset.theme=preferencias.theme;
 document.documentElement.style.setProperty("--rojo",preferencias.color1);
 document.documentElement.style.setProperty("--azul",preferencias.color2);
 document.querySelectorAll(".ficha.roja,.ficha-preview.roja").forEach(x=>x.style.background=preferencias.color1);
 document.querySelectorAll(".ficha.azul,.ficha-preview.azul").forEach(x=>x.style.background=preferencias.color2);
 document.getElementById("temaClaro").classList.toggle("activo",preferencias.theme==="light");
 document.getElementById("temaOscuro").classList.toggle("activo",preferencias.theme==="dark");
}
function cargarControles(){
 document.getElementById("color1").value=preferencias.color1;
 document.getElementById("color2").value=preferencias.color2;
 document.getElementById("hex1").value=preferencias.color1;
 document.getElementById("hex2").value=preferencias.color2;
 for(const tipo of ["caida","victoria","empate","botones"])
  document.getElementById("sonido"+tipo[0].toUpperCase()+tipo.slice(1)).checked=preferencias.sounds[tipo];
}
function actualizarColor(jugador,valor){
 if(!/^#[0-9a-fA-F]{6}$/.test(valor))return;
 const otro=jugador===1?preferencias.color2:preferencias.color1;
 if(valor.toLowerCase()===otro.toLowerCase()){
  document.getElementById("mensajeColores").textContent="Los dos jugadores no pueden tener el mismo color.";
  cargarControles();return;
 }
 preferencias["color"+jugador]=valor;
 guardarPreferencias();aplicarPreferencias();
 document.getElementById("color"+jugador).value=valor;
 document.getElementById("hex"+jugador).value=valor;
 document.getElementById("mensajeColores").textContent="Color actualizado correctamente.";
 if(tablero.length)dibujarTablero();
}
