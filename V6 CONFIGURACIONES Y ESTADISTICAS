function pedirReset(){document.getElementById("confirmacionReset").classList.add("visible")}
function cancelarReset(){document.getElementById("confirmacionReset").classList.remove("visible")}
function confirmarReset(){
 estadisticas={cpu:{ganadas:0,perdidas:0,empates:0,racha:0,mejorRacha:0},local:{p1:0,p2:0,empates:0}};
 guardarEstadisticas();actualizarEstadisticas();cancelarReset();
}

/* AMBIENTE */
const ambiente=document.getElementById("ambiente");
const posiciones=[[8,15,34,"azul"],[88,12,24,"roja"],[17,77,22,"roja"],[80,78,38,"azul"],[48,8,17,"roja"],[94,48,19,"azul"],[5,47,16,"roja"],[70,25,14,"azul"],[29,89,18,"azul"],[62,90,25,"roja"],[39,19,13,"azul"],[97,88,15,"roja"]];
posiciones.forEach((d,i)=>{
 const f=document.createElement("div");f.className="particula "+d[3];
