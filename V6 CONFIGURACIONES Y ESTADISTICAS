 if(window.matchMedia("(pointer: coarse)").matches)return;
 document.querySelectorAll(".particula").forEach(f=>{
  const r=f.getBoundingClientRect(),dx=r.left+r.width/2-e.clientX,dy=r.top+r.height/2-e.clientY,d=Math.hypot(dx,dy);
  if(d<180&&d>0){const fuerza=(180-d)/180;f.style.setProperty("--mx",dx/d*fuerza*20+"px");f.style.setProperty("--my",dy/d*fuerza*20+"px")}
  else{f.style.setProperty("--mx","0px");f.style.setProperty("--my","0px")}
 });
});

/* LÓGICA DEL JUEGO */
const FILAS=6,COLUMNAS=7;
let tablero=[],jugadorActual=1,juegoTerminado=false,ultimaFicha=null,columnaSeleccionada=null;
let modoActual=null,cpuPensando=false,temporizadorCPU=null,temporizadorSalida=null,partidaRegistrada=false;
const elementoTablero=document.getElementById("tablero");
const elementoSelector=document.getElementById("selector");
const zonaJuego=document.getElementById("zonaJuego");
const textoEstado=document.getElementById("textoEstado");
const indicador=document.getElementById("indicador");
const elementoEstado=document.getElementById("estado");
const pantallaJuego=document.getElementById("pantallaJuego");

function colorJugador(j){return j===1?preferencias.color1:preferencias.color2}
function nombreJugador(j){return "jugador "+j}
function iniciarModo(modo){
 clearTimeout(temporizadorSalida);modoActual=modo;
 document.getElementById("menu").style.display="none";pantallaJuego.style.display="block";
 pantallaJuego.classList.remove("salida","entrada");void pantallaJuego.offsetWidth;pantallaJuego.classList.add("entrada");
 document.getElementById("infoModo").textContent=modo==="cpu"?"JUGADOR VS COMPUTADORA":"DOS JUGADORES LOCAL";
