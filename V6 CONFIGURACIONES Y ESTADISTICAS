 preferencias.color1=DEFAULTS.color1;preferencias.color2=DEFAULTS.color2;
 guardarPreferencias();cargarControles();aplicarPreferencias();
 if(tablero.length)dibujarTablero();
 document.getElementById("mensajeColores").textContent="Se restauraron los colores originales.";
}
