
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Cuatro en Raya</title>

<style>
*{box-sizing:border-box}
:root{
 --fondo:#f2f2f0;--texto:#242629;--secundario:#85878b;
 --panel:rgba(255,255,255,.88);--borde:rgba(0,0,0,.08);
 --tablero:#fafaf8;--agujero:#e1e2de;--soporte:#e8e9e5;
 --boton:#fff;--sombra:rgba(0,0,0,.06);
 --rojo:#e34848;--azul:#327bd1;
}
body[data-theme="dark"]{
 --fondo:#17191d;--texto:#f0f1f3;--secundario:#a0a3aa;
 --panel:rgba(37,40,46,.96);--borde:rgba(255,255,255,.1);
 --tablero:#292d34;--agujero:#191c21;--soporte:#242830;
 --boton:#30343b;--sombra:rgba(0,0,0,.25);
}
body{
 margin:0;min-height:100vh;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
 color:var(--texto);background:var(--fondo);overflow-x:hidden;
 transition:background .25s,color .25s;
}
button{font-family:inherit;color:inherit}
#ambiente{position:fixed;inset:0;overflow:hidden;pointer-events:none;z-index:0}
.particula{
 position:absolute;width:var(--size);height:var(--size);left:var(--x);top:var(--y);
 border-radius:50%;opacity:var(--opacity);animation:flotar var(--duration) ease-in-out infinite alternate;
 animation-delay:var(--delay);translate:var(--mx,0px) var(--my,0px);
 transition:translate .45s ease-out;
 box-shadow:inset 0 4px 7px rgba(255,255,255,.6),inset 0 -5px 8px rgba(0,0,0,.16),0 10px 22px rgba(0,0,0,.08);
}
.particula.roja{background:radial-gradient(circle at 30% 25%,#ffaaaa,#ed5252 48%,#c72d35)}
.particula.azul{background:radial-gradient(circle at 30% 25%,#a6d2ff,#438bdc 48%,#205ba9)}
@keyframes flotar{from{transform:translateY(-12px) rotate(-8deg)}to{transform:translateY(18px) rotate(8deg)}}
.contenedor{
 position:relative;z-index:1;width:100%;min-height:100vh;padding:30px 24px;
 display:flex;flex-direction:column;align-items:center;
}
.encabezado{
 width:min(100%,1050px);display:flex;justify-content:space-between;align-items:center;
}
.marca{font-size:12px;font-weight:650;letter-spacing:2px;color:var(--secundario)}
.header-acciones{display:flex;align-items:center;gap:9px}
.version{font-size:11px;color:var(--secundario);margin-right:8px}
.icono-header{
 width:38px;height:38px;border:1px solid var(--borde);border-radius:11px;
 background:var(--panel);display:grid;place-items:center;cursor:pointer;
 transition:transform .2s,background .2s;
}
.icono-header:hover{transform:translateY(-2px)}
.icono-header svg{width:19px;height:19px;stroke:var(--texto);fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
#menu{width:min(100%,490px);margin:auto;padding:55px 0 45px;text-align:center}
.titulo-menu{margin:0;font-size:clamp(38px,6vw,56px);font-weight:650;letter-spacing:-2.8px;line-height:1.1}
.subtitulo{margin:13px 0 0;color:var(--secundario);font-size:15px}
.composicion{position:relative;width:100%;height:185px;margin:18px auto 23px;display:flex;justify-content:center;align-items:center;perspective:700px}
.grupo-fichas{position:relative;width:190px;height:130px}
.ficha-decorativa{position:absolute;width:66px;height:66px;border-radius:50%;box-shadow:inset 0 5px 8px rgba(255,255,255,.6),inset 0 -7px 10px rgba(0,0,0,.2),0 13px 20px rgba(0,0,0,.12);animation:movimientoFicha 4s ease-in-out infinite alternate}
.ficha-decorativa.roja{background:radial-gradient(circle at 30% 25%,#ffaaaa,#ed5252 50%,#c72d35)}
.ficha-decorativa.azul{background:radial-gradient(circle at 30% 25%,#a6d2ff,#438bdc 50%,#205ba9)}
.ficha-decorativa:nth-child(1){left:10px;top:43px;z-index:2;animation-delay:-.5s}
.ficha-decorativa:nth-child(2){left:60px;top:5px;z-index:1;animation-delay:-1.5s}
.ficha-decorativa:nth-child(3){left:63px;top:72px;z-index:3;animation-delay:-2s}
.ficha-decorativa:nth-child(4){left:112px;top:38px;z-index:2;animation-delay:-1s}
@keyframes movimientoFicha{from{transform:translateY(-7px) rotate(-8deg)}to{transform:translateY(9px) rotate(8deg)}}
.opciones{display:flex;flex-direction:column;gap:11px;width:100%;text-align:left}
.opcion{
 display:flex;align-items:center;width:100%;min-height:78px;padding:15px 19px;
 border:1px solid var(--borde);border-radius:15px;background:var(--panel);
 text-align:left;cursor:pointer;transition:transform .25s,background .25s,box-shadow .25s;
 box-shadow:0 3px 12px var(--sombra);backdrop-filter:blur(12px);
}
.opcion:hover:not(:disabled){transform:translateY(-3px);box-shadow:0 10px 25px var(--sombra)}
.opcion:active:not(:disabled){transform:scale(.985)}
.opcion:disabled{opacity:.55;cursor:default}
.icono-opcion{flex:0 0 43px;width:43px;height:43px;margin-right:16px;display:grid;place-items:center;border-radius:13px;background:rgba(130,130,130,.12)}
.icono-opcion svg{width:22px;height:22px;stroke:var(--texto);stroke-width:1.7;fill:none;stroke-linecap:round;stroke-linejoin:round}
.contenido-opcion{flex:1;min-width:0}
.opcion-titulo{display:block;font-size:15px;font-weight:620;margin-bottom:5px}
.opcion-descripcion{display:block;font-size:12px;color:var(--secundario)}
.flecha{color:var(--secundario);font-size:22px;margin-left:12px}
.etiqueta{font-size:9px;font-weight:650;letter-spacing:.7px;color:var(--secundario);background:rgba(130,130,130,.13);padding:5px 8px;border-radius:6px}
.pie-menu{margin-top:28px;color:var(--secundario);font-size:10px;font-weight:500;letter-spacing:1.5px}
#pantallaJuego{display:none;width:100%;padding:55px 0 25px;text-align:center}
#pantallaJuego.entrada{animation:entradaPantalla .42s ease both}
#pantallaJuego.salida{animation:salidaPantalla .24s ease-in both}
@keyframes entradaPantalla{from{opacity:0;transform:translateY(15px) scale(.985)}to{opacity:1;transform:translateY(0) scale(1)}}
@keyframes salidaPantalla{to{opacity:0;transform:translateY(8px) scale(.99)}}
#infoModo{margin:0 0 18px;color:var(--secundario);font-size:11px;font-weight:600;letter-spacing:1.4px}
#estado{display:flex;justify-content:center;align-items:center;gap:10px;margin-bottom:22px;font-size:17px;font-weight:600}
#estado.cambio-turno{animation:cambioTurno .32s ease-out}
#estado.resultado{animation:entradaResultado .5s ease both}
@keyframes cambioTurno{from{opacity:.45;transform:translateY(5px)}to{opacity:1;transform:translateY(0)}}
@keyframes entradaResultado{0%{opacity:0;transform:translateY(12px) scale(.94)}65%{transform:translateY(-2px) scale(1.025)}100%{opacity:1;transform:none}}
#indicador{width:13px;height:13px;flex-shrink:0;border-radius:50%;background:var(--rojo);box-shadow:0 0 10px currentColor;transition:background .35s,transform .35s}
#estado.cambio-turno #indicador{animation:pulsoIndicador .35s}
@keyframes pulsoIndicador{0%{transform:scale(.65)}65%{transform:scale(1.35)}100%{transform:scale(1)}}
.puntos-pensando{display:inline-flex;margin-left:2px}
.puntos-pensando span{animation:puntosPensando .9s infinite}
.puntos-pensando span:nth-child(2){animation-delay:.15s}
.puntos-pensando span:nth-child(3){animation-delay:.3s}
@keyframes puntosPensando{0%,60%,100%{opacity:.25;transform:translateY(0)}30%{opacity:1;transform:translateY(-3px)}}
#zonaJuego{position:relative;width:min(90vw,490px);margin:0 auto 25px}
#zonaJuego.entrada-tablero{animation:entradaTablero .45s ease both}
@keyframes entradaTablero{from{opacity:0;transform:translateY(12px) scale(.98)}to{opacity:1;transform:none}}
#selector{display:grid;grid-template-columns:repeat(7,1fr);gap:9px;padding:0 15px;margin-bottom:12px}
.selector-columna{height:48px;display:flex;align-items:center;justify-content:center;border-radius:12px;cursor:pointer}
.selector-columna.activa{background:rgba(130,130,130,.12)}
.ficha-preview{width:75%;aspect-ratio:1;border-radius:50%;opacity:0;transform:translateY(-8px) scale(.8);transition:opacity .15s,transform .15s}
.ficha-preview.visible{opacity:1;transform:none}
#tablero{position:relative;z-index:2;display:grid;grid-template-columns:repeat(7,1fr);gap:9px;width:100%;padding:14px;background:var(--tablero);border:1px solid var(--borde);border-radius:17px;box-shadow:0 5px 12px var(--sombra)}
.celda{position:relative;aspect-ratio:1;display:flex;align-items:center;justify-content:center;background:var(--agujero);border-radius:50%;box-shadow:inset 0 2px 4px rgba(0,0,0,.12),inset 0 -1px 2px rgba(255,255,255,.25);cursor:pointer}
.ficha{position:absolute;z-index:5;width:84%;height:84%;border-radius:50%;box-shadow:0 1px 3px rgba(0,0,0,.13),inset 0 1px 1px rgba(255,255,255,.25);transition:opacity .35s,filter .35s}
#soporte{position:relative;z-index:1;width:100%;height:43px;margin-top:-1px}
#soporte::before{content:"";position:absolute;top:0;left:34%;width:32%;height:27px;background:var(--soporte);border-left:1px solid var(--borde);border-right:1px solid var(--borde)}
#soporte::after{content:"";position:absolute;bottom:3px;left:6%;width:88%;height:17px;border:1px solid var(--borde);border-radius:7px;background:var(--soporte);box-shadow:0 4px 7px var(--sombra)}
.ficha.caida{animation:caer .85s cubic-bezier(.25,.8,.25,1) both}
@keyframes caer{0%{transform:translateY(-480px) scale(.85,.9)}58%{transform:translateY(0) scale(1.08,.88)}70%{transform:translateY(-24px) scale(.96,1.04)}82%{transform:translateY(0) scale(1.04,.96)}91%{transform:translateY(-7px) scale(.99,1.01)}100%{transform:none}}
.celda.impacto::after{content:"";position:absolute;z-index:6;width:90%;height:90%;border:2px solid rgba(255,255,255,.9);border-radius:50%;pointer-events:none;animation:ondaImpacto .4s ease-out forwards}
@keyframes ondaImpacto{0%{transform:scale(.45);opacity:.9}100%{transform:scale(1.35);opacity:0}}
#tablero.golpe{animation:golpeTablero .22s ease-out}
@keyframes golpeTablero{0%,100%{transform:translateY(0)}30%{transform:translateY(2px)}60%{transform:translateY(-1px)}}
.ficha.ganadora{z-index:7;animation:brilloGanador .95s ease-in-out infinite alternate}
.ficha.no-ganadora{opacity:.28;filter:saturate(.55)}
@keyframes brilloGanador{from{filter:brightness(1);box-shadow:0 1px 3px rgba(0,0,0,.13)}to{filter:brightness(1.3);box-shadow:0 0 0 4px rgba(255,255,255,.65),0 0 18px rgba(255,255,255,.75)}}
.boton{padding:12px 20px;margin:5px;border:1px solid var(--borde);border-radius:9px;background:var(--boton);font-size:13px;font-weight:600;cursor:pointer;transition:background .2s,transform .2s}
.boton:hover{transform:translateY(-2px)}
.boton:active{transform:scale(.97)}
.instruccion{margin-top:18px;color:var(--secundario);font-size:12px}

/* VENTANAS DE AJUSTES Y ESTADÍSTICAS */
.capa-modal{
 display:none;position:fixed;inset:0;z-index:20;background:rgba(0,0,0,.42);
 backdrop-filter:blur(5px);align-items:center;justify-content:center;padding:18px;
}
.capa-modal.visible{display:flex;animation:aparecer .2s ease}
@keyframes aparecer{from{opacity:0}to{opacity:1}}
.modal{
 width:min(100%,470px);max-height:85vh;overflow-y:auto;padding:25px;
 background:var(--panel);border:1px solid var(--borde);border-radius:19px;
 box-shadow:0 20px 70px rgba(0,0,0,.2);text-align:left;
}
.modal-cabecera{display:flex;justify-content:space-between;align-items:center;margin-bottom:22px}
.modal-titulo{font-size:21px;font-weight:650;letter-spacing:-.5px;margin:0}
.cerrar-modal{border:0;background:transparent;color:var(--secundario);font-size:25px;cursor:pointer;padding:0 5px}
.seccion-ajuste{padding:17px 0;border-top:1px solid var(--borde)}
.seccion-titulo{font-size:12px;font-weight:700;letter-spacing:1px;color:var(--secundario);margin:0 0 14px;text-transform:uppercase}
.fila-ajuste{display:flex;justify-content:space-between;align-items:center;gap:12px;margin:12px 0;font-size:14px}
.fila-ajuste small{display:block;color:var(--secundario);font-size:11px;margin-top:4px}
.selector-color{display:flex;align-items:center;gap:8px}
.selector-color input[type=color]{width:38px;height:34px;border:1px solid var(--borde);border-radius:8px;background:transparent;padding:2px;cursor:pointer}
.hex-input{width:92px;padding:8px;border:1px solid var(--borde);border-radius:8px;background:var(--boton);color:var(--texto);font:12px monospace;text-transform:uppercase}
.switch{width:42px;height:24px;position:relative;flex-shrink:0}
.switch input{opacity:0;width:0;height:0}
.switch span{position:absolute;inset:0;background:#999;border-radius:20px;cursor:pointer;transition:.2s}
.switch span:before{content:"";position:absolute;width:18px;height:18px;left:3px;top:3px;background:white;border-radius:50%;transition:.2s}
.switch input:checked+span{background:#438bdc}
.switch input:checked+span:before{transform:translateX(18px)}
.opciones-tema{display:flex;gap:9px}
.tema-opcion{flex:1;padding:11px;border:1px solid var(--borde);border-radius:9px;background:var(--boton);cursor:pointer;font-size:13px}
.tema-opcion.activo{border-color:var(--azul);box-shadow:inset 0 0 0 1px var(--azul)}
.boton-secundario{border:1px solid var(--borde);background:var(--boton);border-radius:8px;padding:9px 12px;font-size:12px;cursor:pointer}
.ayuda{color:var(--secundario);font-size:11px;line-height:1.5;margin:10px 0 0}
.stats-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
.stat-card{padding:15px;border:1px solid var(--borde);border-radius:12px;background:rgba(130,130,130,.07)}
.stat-numero{font-size:25px;font-weight:700;letter-spacing:-1px}
.stat-label{font-size:11px;color:var(--secundario);margin-top:4px}
.stats-subtitulo{font-size:13px;font-weight:650;margin:18px 0 10px}
.modal-acciones{display:flex;justify-content:flex-end;gap:8px;margin-top:20px}
.boton-peligro{background:#b83b3b;color:white;border:0;border-radius:8px;padding:10px 13px;font-size:12px;cursor:pointer}
.confirmacion{display:none;margin-top:15px;padding:13px;border:1px solid var(--borde);border-radius:10px;background:rgba(130,130,130,.08)}
.confirmacion.visible{display:block}
.confirmacion p{font-size:13px;margin:0 0 12px}
.confirmacion .modal-acciones{margin-top:0}
@media(max-width:480px){
 .contenedor{padding:22px 17px}#menu{padding-top:65px}
 .titulo-menu{font-size:40px;letter-spacing:-2px}
 .composicion{height:160px}#zonaJuego{width:94vw}
 #selector{gap:6px;padding:0 10px}
 #tablero{gap:6px;padding:10px;border-radius:13px}
 .selector-columna{height:40px}.opcion{min-height:75px;padding:13px}
 #soporte{height:38px}.modal{padding:20px}
}
@media(prefers-reduced-motion:reduce){
 *,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}
}
</style>
</head>

<body>
<div id="ambiente" aria-hidden="true"></div>
<div class="contenedor">

<header class="encabezado">
 <span class="marca">CUATRO EN RAYA</span>
 <div class="header-acciones">
  <span class="version">01 / GAME</span>
  <button class="icono-header" onclick="abrirModal('estadisticas')" aria-label="Estadísticas" title="Estadísticas">
   <svg viewBox="0 0 24 24"><path d="M4 19V5M4 19h17"/><path d="M8 15l4-4 3 2 5-7"/></svg>
  </button>
  <button class="icono-header" onclick="abrirModal('ajustes')" aria-label="Ajustes" title="Ajustes">
   <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-1.7 1.7-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.5v.2h-2.4v-.2a1.7 1.7 0 0 0-1-1.5 1.7 1.7 0 0 0-1.9.3l-.1.1L8 17l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.5-1H6.7v-2.4h.2a1.7 1.7 0 0 0 1.5-1 1.7 1.7 0 0 0-.3-1.9L8 8.6l1.7-1.7.1.1a1.7 1.7 0 0 0 1.9.3 1.7 1.7 0 0 0 1-1.5v-.2h2.4v.2a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.9-.3l.1-.1 1.7 1.7-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.5 1h.2V14h-.2a1.7 1.7 0 0 0-1.5 1z"/></svg>
  </button>
 </div>
</header>

<div id="menu">
 <h1 class="titulo-menu">Cuatro en Raya.</h1>
 <p class="subtitulo">Una partida. Cuatro fichas. Una victoria.</p>
 <div class="composicion" aria-hidden="true">
  <div class="grupo-fichas">
   <div class="ficha-decorativa roja"></div><div class="ficha-decorativa azul"></div>
   <div class="ficha-decorativa roja"></div><div class="ficha-decorativa azul"></div>
  </div>
 </div>
 <div class="opciones">
  <button class="opcion" onclick="iniciarModo('cpu')">
   <span class="icono-opcion"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><path d="M8 12h8M12 8v8"/></svg></span>
   <span class="contenido-opcion"><span class="opcion-titulo">Jugar contra CPU</span><span class="opcion-descripcion">Poné a prueba tu estrategia.</span></span><span class="flecha">›</span>
  </button>
  <button class="opcion" onclick="iniciarModo('local')">
   <span class="icono-opcion"><svg viewBox="0 0 24 24"><circle cx="9" cy="9" r="4"/><circle cx="17" cy="10" r="3"/><path d="M2.5 20c.4-3.5 2.6-5.2 6.5-5.2s6.1 1.7 6.5 5.2M15 15c3.4-.5 5.5 1.1 6 4"/></svg></span>
   <span class="contenido-opcion"><span class="opcion-titulo">Jugar local</span><span class="opcion-descripcion">Compartí la partida.</span></span><span class="flecha">›</span>
  </button>
  <button class="opcion" disabled>
   <span class="icono-opcion"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.5 3.5 5.5 3.5 9s-1 6.5-3.5 9c-2.5-2.5-3.5-5.5-3.5-9s1-6.5 3.5-9z"/></svg></span>
   <span class="contenido-opcion"><span class="opcion-titulo">Online</span><span class="opcion-descripcion">Desafiá a otros jugadores.</span></span><span class="etiqueta">PRÓXIMAMENTE</span>
  </button>
 </div>
 <div class="pie-menu">DISEÑADO PARA DISFRUTAR CADA PARTIDA</div>
</div>

<div id="pantallaJuego">
 <p id="infoModo"></p>
 <div id="estado"><span id="indicador"></span><span id="textoEstado">Turno del jugador 1</span></div>
 <div id="zonaJuego">
  <div id="selector"></div><div id="tablero"></div><div id="soporte"></div>
 </div>
 <button class="boton" onclick="reiniciarJuego()">Reiniciar partida</button>
 <button class="boton" onclick="volverMenu()">Cambiar modo</button>
 <p class="instruccion">Mové el mouse para elegir una columna y hacé clic para soltar la ficha.</p>
</div>
</div>

<!-- AJUSTES -->
<div class="capa-modal" id="modalAjustes" onclick="cerrarAlFondo(event,'ajustes')">
 <div class="modal">
  <div class="modal-cabecera"><h2 class="modal-titulo">Ajustes</h2><button class="cerrar-modal" onclick="cerrarModal('ajustes')">×</button></div>

  <section class="seccion-ajuste">
   <h3 class="seccion-titulo">Colores de las fichas</h3>
   <div class="fila-ajuste">
    <div>Jugador 1<small>Elegí el color de sus fichas.</small></div>
    <div class="selector-color"><input type="color" id="color1"><input class="hex-input" id="hex1" maxlength="7"></div>
   </div>
   <div class="fila-ajuste">
    <div>Jugador 2<small>Debe ser diferente al del jugador 1.</small></div>
    <div class="selector-color"><input type="color" id="color2"><input class="hex-input" id="hex2" maxlength="7"></div>
   </div>
   <p class="ayuda" id="mensajeColores">Los cambios se aplican inmediatamente.</p>
   <button class="boton-secundario" onclick="restaurarColores()">Restaurar colores originales</button>
  </section>

  <section class="seccion-ajuste">
   <h3 class="seccion-titulo">Sonidos</h3>
   <div class="fila-ajuste"><span>Caída de ficha</span><label class="switch"><input type="checkbox" id="sonidoCaida"><span></span></label></div>
   <div class="fila-ajuste"><span>Victoria</span><label class="switch"><input type="checkbox" id="sonidoVictoria"><span></span></label></div>
   <div class="fila-ajuste"><span>Empate</span><label class="switch"><input type="checkbox" id="sonidoEmpate"><span></span></label></div>
   <div class="fila-ajuste"><span>Botones</span><label class="switch"><input type="checkbox" id="sonidoBotones"><span></span></label></div>
   <p class="ayuda">Los sonidos se generan en el navegador. No necesitan archivos externos.</p>
  </section>

  <section class="seccion-ajuste">
   <h3 class="seccion-titulo">Apariencia</h3>
   <div class="opciones-tema">
    <button class="tema-opcion" id="temaClaro" onclick="cambiarTema('light')">☀ Claro</button>
