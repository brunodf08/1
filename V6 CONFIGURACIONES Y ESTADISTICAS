  preferencias.sounds[tipo]=e.target.checked;guardarPreferencias();
 });
}
aplicarPreferencias();cargarControles();

/* SONIDOS SINTETIZADOS */
let contextoAudio=null;
function tono(frecuencia,duracion,forma="sine",volumen=.07,retardo=0){
 try{
  contextoAudio=contextoAudio||new (window.AudioContext||window.webkitAudioContext)();
  if(contextoAudio.state==="suspended")contextoAudio.resume();
  const oscilador=contextoAudio.createOscillator(),ganancia=contextoAudio.createGain();
  oscilador.type=forma;oscilador.frequency.value=frecuencia;
  ganancia.gain.setValueAtTime(volumen,contextoAudio.currentTime+retardo);
  ganancia.gain.exponentialRampToValueAtTime(.001,contextoAudio.currentTime+retardo+duracion);
  oscilador.connect(ganancia);ganancia.connect(contextoAudio.destination);
  oscilador.start(contextoAudio.currentTime+retardo);oscilador.stop(contextoAudio.currentTime+retardo+duracion);
 }catch(e){}
}
function sonido(tipo){
 if(!preferencias.sounds[tipo])return;
 if(tipo==="caida")tono(180,.11,"triangle",.055);
 if(tipo==="botones")tono(480,.055,"sine",.035);
 if(tipo==="empate"){tono(330,.2,"sine",.06);tono(260,.28,"sine",.05, .2)}
 if(tipo==="victoria"){tono(440,.18,"sine",.06);tono(554,.18,"sine",.06,.16);tono(659,.32,"sine",.06,.32)}
}
document.addEventListener("click",e=>{
 const b=e.target.closest("button");
 if(b&&!b.disabled&&!b.closest(".switch")&&!b.classList.contains("tema-opcion"))sonido("botones");
});

